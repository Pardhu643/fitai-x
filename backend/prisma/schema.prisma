generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PrimaryGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  STRENGTH
  FLEXIBILITY
  GENERAL_FITNESS
}

enum WorkoutGoal {
  FAT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  ATHLETIC_PERFORMANCE
  GENERAL_FITNESS
}

enum DietType {
  VEGETARIAN
  VEGAN
  NON_VEGETARIAN
  EGGETARIAN
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
}

enum EquipmentType {
  GYM
  DUMBBELLS
  RESISTANCE_BANDS
  PULL_UP_BAR
  BENCH
  HOME_ONLY
  NO_EQUIPMENT
}

enum InjuryType {
  BACK_PAIN
  SHOULDER_PAIN
  KNEE_PAIN
  OTHER
}

model User {
  id                     String        @id @default(cuid())
  name                   String
  email                  String        @unique
  passwordHash           String
  role                   Role          @default(USER)
  age                    Int?
  gender                 Gender?
  heightCm               Int?
  weightKg               Float?
  fitnessLevel           FitnessLevel?
  primaryGoal            PrimaryGoal?
  profileImageUrl        String?
  hasCompletedOnboarding Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  workoutPlans           WorkoutPlan[]
  userPreferences        UserPreferences?
  goals                  Goal[]
  bodyMeasurements       BodyMeasurement[]
  workoutHistory         WorkoutHistory[]
  userEquipments         UserEquipment[]
  injuries               Injury[]
  workoutSessions        WorkoutSession[]
  recoveryEntries        RecoveryEntry[]
  planChangeExplanations PlanChangeExplanation[]
  coachConversations     CoachConversation[]
  habits                 Habit[]
  calendarEvents         CalendarEvent[]
  notifications          Notification[]
  aiMemories             AIMemory[]
  nutritionProfile       NutritionProfile?
  nutritionTargets       NutritionTarget[]
  mealPlans              MealPlan[]
  groceryLists           GroceryList[]
  mealLogs               MealLog[]
  fatigueAssessments     FatigueAssessment[]

  @@map("users")
}

model UserPreferences {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietType               DietType?
  budget                 String?
  cookingSkill           String?
  preferredTime          TimeOfDay?
  workoutDaysPerWeek     Int?
  workoutDurationMinutes Int?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@map("user_preferences")
}

model Equipment {
  id            String          @id @default(cuid())
  name          String          @unique
  type          EquipmentType
  createdAt     DateTime        @default(now())
  userEquipment UserEquipment[]

  @@map("equipment")
}

model UserEquipment {
  id          String    @id @default(cuid())
  userId      String
  equipmentId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, equipmentId])
  @@map("user_equipment")
}

model Injury {
  id        String     @id @default(cuid())
  userId    String
  type      InjuryType
  details   String?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@map("injuries")
}

model Goal {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetWeightKg Float?
  targetBodyFat  Float?
  targetDate     DateTime?
  isAchieved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("goals")
}

model BodyMeasurement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg       Float
  bodyFatPercent Float?
  chestCm        Float?
  waistCm        Float?
  hipsCm         Float?
  bicepsCm       Float?
  thighsCm       Float?
  measuredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("body_measurements")
}

model WorkoutPlan {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  goal            WorkoutGoal
  fitnessLevel    FitnessLevel // experienceLevel
  daysPerWeek     Int
  durationMinutes Int
  isActive        Boolean      @default(true)
  status          String       @default("ACTIVE") // "ACTIVE", "ARCHIVED"
  version         Int          @default(1)
  generatedAt     DateTime     @default(now())
  startDate       DateTime     @default(now())
  endDate         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workoutDays  WorkoutDay[]
  versions     WorkoutPlanVersion[]
  explanations PlanChangeExplanation[]

  @@map("workout_plans")
}

model WorkoutDay {
  id                String            @id @default(cuid())
  workoutPlanId     String
  workoutPlan       WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  dayOfWeek         Int // dayNumber
  dayNumber         Int               @default(0)
  name              String // title
  title             String            @default("")
  durationMinutes   Int // estimatedDuration
  estimatedDuration Int               @default(0)
  focus             String?
  notes             String?
  exercises         Exercise[] // old relation kept for compatibility
  workoutExercises  WorkoutExercise[] // new relation
  workoutSessions   WorkoutSession[]

  @@map("workout_days")
}

model Exercise {
  id              String        @id @default(cuid())
  workoutDayId    String
  workoutDay      WorkoutDay    @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  name            String
  muscleGroup     String
  equipmentNeeded String?
  instructions    String?
  order           Int
  exerciseSets    ExerciseSet[]

  @@map("exercises")
}

model ExerciseSet {
  id              String   @id @default(cuid())
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reps            Int
  weightKg        Float?
  restTimeSeconds Int
  order           Int
  isCompleted     Boolean  @default(false)

  @@map("exercise_sets")
}

model WorkoutHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlanId   String?
  workoutDayId    String?
  completedAt     DateTime @default(now())
  durationMinutes Int
  caloriesBurned  Int?
  notes           String?
  rating          Int?
  createdAt       DateTime @default(now())

  @@map("workout_history")
}

model ExerciseLibrary {
  id                String            @id @default(cuid())
  name              String            @unique
  category          String
  primaryMuscle     String
  secondaryMuscles  String[]
  equipment         String[]
  difficulty        String
  instructions      String[]
  contraindications String[]
  workoutExercises  WorkoutExercise[]

  @@map("exercise_library")
}

model WorkoutExercise {
  id           String          @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay      @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     ExerciseLibrary @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order        Int
  setsCount    Int             @default(3)
  repsMin      Int             @default(8)
  repsMax      Int             @default(12)
  targetWeight Float?
  restSeconds  Int             @default(90)
  tempo        String?         @default("2-0-2-0")
  notes        String?
  sets         WorkoutSet[]

  @@map("workout_exercises")
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  weightKg          Float?
  reps              Int
  order             Int
  isCompleted       Boolean         @default(false)

  @@map("workout_sets")
}

model WorkoutSession {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDayId        String
  workoutDay          WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  status              String     @default("ACTIVE") // "ACTIVE", "COMPLETED"
  startedAt           DateTime   @default(now())
  completedAt         DateTime?
  durationMinutes     Int?
  perceivedDifficulty Int?
  notes               String?

  @@map("workout_sessions")
}

model RecoveryEntry {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @default(now())
  sleepHours          Float
  sleepQuality        String // "EXCELLENT", "GOOD", "FAIR", "POOR"
  hydrationLevel      String // "HIGH", "MEDIUM", "LOW"
  sorenessLevel       String // "NONE", "LIGHT", "HEAVY"
  stressLevel         String // "LOW", "MEDIUM", "HIGH"
  energyLevel         String // "HIGH", "MEDIUM", "LOW"
  previousWorkoutLoad String // "LIGHT", "MODERATE", "INTENSE"
  score               Int
  recommendation      String

  @@map("recovery_entries")
}

model WorkoutPlanVersion {
  id            String      @id @default(cuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changeReason  String?
  createdAt     DateTime    @default(now())

  @@map("workout_plan_versions")
}

model PlanChangeExplanation {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  title         String
  explanation   String
  previousValue String?
  newValue      String?
  createdAt     DateTime    @default(now())

  @@map("plan_change_explanations")
}

model CoachConversation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  CoachMessage[]

  @@map("coach_conversations")
}

model CoachMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "USER", "ASSISTANT", "SYSTEM"
  content        String
  intent         String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@map("coach_messages")
}

model AIMemory {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // "PROFILE_CHANGE", "FITNESS_PREFERENCE", etc.
  title      String
  summary    String
  source     String?
  importance String    @default("NORMAL") // "NORMAL", "HIGH"
  occurredAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("ai_memories")
}

model Habit {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String // "WATER", "SLEEP", etc.
  targetValue Float
  unit        String
  frequency   String     @default("DAILY")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  value     Float
  completed Boolean  @default(false)
  logDate   DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, logDate])
  @@map("habit_logs")
}

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  type            String // "WORKOUT", "RECOVERY", "HABIT", etc.
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean  @default(false)
  status          String   @default("SCHEDULED")
  workoutPlanId   String?
  workoutDayId    String?
  reminderMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("calendar_events")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "WORKOUT_REMINDER", etc.
  title     String
  message   String
  actionUrl String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
  expiresAt DateTime?

  @@map("notifications")
}

model NutritionProfile {
  id                         String             @id @default(cuid())
  userId                     String             @unique
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryPreference          DietaryPreference? @default(BALANCED)
  allergies                  String[]
  dislikedFoods              String[]
  preferredCuisines          String[]
  mealsPerDay                Int                @default(3)
  cookingSkill               CookingSkill?      @default(BEGINNER)
  maximumCookingTime         Int                @default(60)
  budgetPreference           BudgetPreference?  @default(MEDIUM)
  preferredMealTimes         String[]
  calorieTargetOverride      Int?
  proteinTargetOverride      Int?
  carbohydrateTargetOverride Int?
  fatTargetOverride          Int?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@map("nutrition_profiles")
}

model NutritionTarget {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories          Int
  proteinGrams      Int
  carbohydrateGrams Int
  fatGrams          Int
  fibreGrams        Int
  waterMl           Int
  goal              NutritionGoal @default(GENERAL_FITNESS)
  source            String        @default("CALCULATOR")
  effectiveFrom     DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@map("nutrition_targets")
}

enum DietaryPreference {
  BALANCED
  VEGETARIAN
  VEGAN
  KETO
  PALEO
  PESCATARIAN
  ANY
}

enum NutritionGoal {
  FAT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
  ENDURANCE
  GENERAL_FITNESS
}

enum CookingSkill {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BudgetPreference {
  LOW
  MEDIUM
  HIGH
}

model MealPlan {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  startDate         DateTime
  endDate           DateTime
  dailyCalories     Int
  status            String        @default("ACTIVE") // "ACTIVE", "ARCHIVED"
  generationSource  String        @default("AI") // "AI", "SYSTEM"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  days              MealPlanDay[]
  groceryLists      GroceryList[]

  @@map("meal_plans")
}

model MealPlanDay {
  id                 String   @id @default(cuid())
  mealPlanId         String
  mealPlan           MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  date               DateTime
  calorieTarget      Int
  totalCalories      Int      @default(0)
  totalProtein       Int      @default(0)
  totalCarbohydrates Int      @default(0)
  totalFat           Int      @default(0)
  meals              Meal[]

  @@map("meal_plan_days")
}

model Meal {
  id                 String           @id @default(cuid())
  mealPlanDayId      String
  mealPlanDay        MealPlanDay      @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  mealType           String           // "BREAKFAST", "LUNCH", "DINNER", "SNACK"
  title              String
  description        String?
  instructions       String[]
  preparationMinutes Int              @default(0)
  cookingMinutes     Int              @default(0)
  servings           Int              @default(1)
  calories           Int
  proteinGrams       Int
  carbohydrateGrams  Int
  fatGrams           Int
  fibreGrams         Int              @default(0)
  imageUrl           String?
  generatedBy        String           @default("AI")
  displayOrder       Int              @default(0)
  ingredients        MealIngredient[]
  logs               MealLog[]

  @@map("meals")
}

model MealIngredient {
  id             String   @id @default(cuid())
  mealId         String
  meal           Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  quantity       Float
  unit           String
  category       String   // "produce", "meat", "dairy", etc.
  optional       Boolean  @default(false)

  @@map("meal_ingredients")
}

model GroceryList {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanId String?
  mealPlan   MealPlan?     @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  title      String
  startDate  DateTime
  endDate    DateTime
  status     String        @default("ACTIVE")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      GroceryItem[]

  @@map("grocery_lists")
}

model GroceryItem {
  id            String      @id @default(cuid())
  groceryListId String
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  name          String
  normalizedName String
  quantity      Float
  unit          String
  category      String
  checked       Boolean     @default(false)
  manuallyAdded Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("grocery_items")
}

model MealLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId           String
  meal             Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  status           String   // "PLANNED", "CONSUMED", "PARTIALLY_CONSUMED", "SKIPPED"
  consumedServings Float    @default(1.0)
  actualCalories   Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("meal_logs")
}

enum FatigueLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model FatigueAssessment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  score             Int           // 0-100, higher = more fatigued
  level             FatigueLevel
  confidence        Float         // 0-1, based on available signals
  explanation       String        // Human-readable explanation
  recommendedAction String
  factors           FatigueFactor[]
  calculationVersion String       @default("1.0")
  calculatedAt      DateTime      @default(now())
  forceRecalculate  Boolean       @default(false)

  @@index([userId, calculatedAt])
  @@map("fatigue_assessments")
}

model FatigueFactor {
  id                String           @id @default(cuid())
  assessmentId      String
  assessment        FatigueAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name              String           // e.g., "recent_workout_load", "sleep_quality"
  value             Float            // Normalized 0-1
  weight            Float            // Contribution to total score
  impact            String           // "HIGH", "MEDIUM", "LOW"
  description       String           // Human-readable description

  @@map("fatigue_factors")
}
